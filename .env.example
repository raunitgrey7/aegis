# Aegis configuration — copy to .env and edit. All settings use the AEGIS_ prefix.

# runtime
AEGIS_ENV=development
AEGIS_API_PORT=8000
AEGIS_CORS_ORIGINS=["http://localhost:3000"]

# security — CHANGE THESE IN PRODUCTION
AEGIS_JWT_SECRET=change-me-in-production-please-32-bytes-min
AEGIS_INGEST_API_KEY=aegis-dev-ingest-key
AEGIS_ADMIN_USERNAME=admin
AEGIS_ADMIN_PASSWORD=admin

# persistence (optional — defaults to local SQLite + in-memory bus)
# AEGIS_DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis
# AEGIS_REDIS_URL=redis://localhost:6379/0

# local LLM (optional — the platform degrades to a deterministic narrative without it)
AEGIS_LLM_ENABLED=true
AEGIS_OLLAMA_URL=http://localhost:11434
AEGIS_OLLAMA_MODEL=llama3.1:8b

# detection tuning
AEGIS_CORRELATION_WINDOW_SECONDS=3600
AEGIS_INCIDENT_MIN_SCORE=40
AEGIS_RATE_LIMIT_PER_MINUTE=600

# frontend (set in frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000/api
